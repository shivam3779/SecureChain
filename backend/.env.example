# ─── Core ───────────────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
FRONTEND_URL=http://localhost:5173

# ─── GitHub OAuth (required for login) ──────────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# GitHub PAT (optional) — raises API rate limit from 60 → 5000 req/hr
# Create at: https://github.com/settings/tokens (no special scopes needed)
GITHUB_TOKEN=

# ─── Google OAuth (optional — enables "Continue with Google" login) ──────────
# Create at: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client
# Authorised redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─── Vulnerability databases (optional API keys raise rate limits) ────────────
# NVD: free at https://nvd.nist.gov/developers/request-an-api-key
# Raises limit from 5 req/30s → 50 req/30s
NVD_API_KEY=

# ─── AI Threat Engine (Google Gemini AI) ──────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Required for: /api/ai/explain, /api/ai/classify, /api/ai/remediate,
#               /api/ai/root-cause, /api/ai/predict-risk, /api/ai/chat
# All other platform features work without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Anthropic Claude fallback
ANTHROPIC_API_KEY=

# ─── Database (optional — defaults to lowdb JSON file store) ─────────────────
# To use Supabase/PostgreSQL instead:
#   1. Create project at https://supabase.com
#   2. Run schema SQL from src/db/supabaseStore.js in the SQL editor
#   3. Change store import in src/server.js:
#      const { db, init, uuid } = require('./db/supabaseStore');
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Webhook signing (optional — validates incoming CI/CD webhook payloads) ──
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# ─── Notification channels (set per-repo via API, stored in DB) ─────────────
# These are not used directly — configure via PUT /api/repos/:id/alert-channels
# Documented here for reference only.
# SLACK_WEBHOOK_URL=
# JIRA_BASE_URL=
# JIRA_API_TOKEN=
# PAGERDUTY_ROUTING_KEY=
