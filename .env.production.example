# Copy to .env alongside docker-compose.yml and fill in values
# Never commit .env to version control

# Required
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The GitHub OAuth callback must match what you registered in your GitHub OAuth App
# For local Docker: http://localhost/api/auth/github/callback
# For production:   https://yourdomain.com/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# Where the backend redirects after OAuth (your frontend URL)
FRONTEND_URL=http://localhost

# Optional — raises rate limits and enables more features
GITHUB_TOKEN=
NVD_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
